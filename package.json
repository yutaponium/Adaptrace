{
  "name": "adaptrace",
  "version": "1.0.0",
  "description": "Manage requirements, decisions, tasks, risks and their dependencies as OKF-compliant Markdown",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "adaptrace": "./src/cli.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
