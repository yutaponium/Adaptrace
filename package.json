    "test": "bun test",
    "validate:self": "bun src/cli.ts validate .adaptrace"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
